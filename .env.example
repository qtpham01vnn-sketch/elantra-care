# HƯỚNG DẪN KẾT NỐI SUPABASE (TÙY CHỌN)
# Mặc định ứng dụng tự động chạy ở chế độ LOCAL DEMO (với Mock Data thực tế) mà không cần cấu hình file này.
# Nếu muốn kết nối với Supabase Cloud Database:
# 1. Đổi tên file này thành .env
# 2. Điền URL và Anon Key lấy từ Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
